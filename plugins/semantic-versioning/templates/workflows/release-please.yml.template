# Copy as .github/workflows/release.yml, with one chosen publisher as release-publish.yml.
name: Release PR and publication
on:
  push:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: release-coordinator-main
  cancel-in-progress: false
jobs:
  release:
    runs-on: ubuntu-24.04
    permissions:
      contents: write
      pull-requests: write
    outputs:
      created: ${{ steps.release.outputs.release_created }}
      revision: ${{ steps.release.outputs.sha }}
      tag: ${{ steps.release.outputs.tag_name }}
      version: ${{ steps.release.outputs.version }}
    steps:
      - uses: googleapis/release-please-action@5c625bfb5d1ff62eadeeb3772007f7f66fdcf071
        id: release
        with:
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json
  publish:
    needs: release
    if: needs.release.outputs.created == 'true'
    uses: ./.github/workflows/release-publish.yml
    permissions:
      contents: write
      id-token: write
      packages: write
    with:
      revision: ${{ needs.release.outputs.revision }}
      tag: ${{ needs.release.outputs.tag }}
      version: ${{ needs.release.outputs.version }}
    secrets: inherit
