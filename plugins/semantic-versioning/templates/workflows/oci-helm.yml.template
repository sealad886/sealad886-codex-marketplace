# Inactive example. Read references/ci/github-actions.md before materializing.
name: Publish oci-helm
on:
  workflow_call:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
  workflow_dispatch:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: publish-oci-helm-main
  cancel-in-progress: false
jobs:
  publish:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    environment: release
    permissions:
      contents: read
      packages: write
    env:
      RELEASE_SHA: ${{ inputs.revision }}
      RELEASE_TAG: ${{ inputs.tag }}
      RELEASE_VERSION: ${{ inputs.version }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.revision }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable release source
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
          git check-ref-format "refs/tags/$RELEASE_TAG"
          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
          test "$(git rev-parse --verify "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
          git merge-base --is-ancestor "$RELEASE_SHA" refs/remotes/origin/main
          test -n "$RELEASE_VERSION"
          test "$RELEASE_TAG" = "v$RELEASE_VERSION"
      - uses: azure/setup-helm@b9e51907a09c216f16ebe8536097933489208112
        with:
          version: v3.17.2
      - name: Check Helm CLI and chart metadata
        env:
          EXPECTED_HELM: v3.17.2
        run: |
          test "$(helm version --template '{{.Version}}')" = "$EXPECTED_HELM"
          helm lint chart
          test "$(helm show chart chart | sed -n 's/^version: //p')" = "$RELEASE_VERSION"
          test "$(helm show chart chart | sed -n 's/^appVersion: //p' | tr -d '"')" = "$RELEASE_VERSION"
      - name: Package chart before any publication
        run: |
          helm package chart --destination artifacts
          printf '%s\n' "$RELEASE_SHA" > artifacts/source-revision.txt
          (cd artifacts && sha256sum ./*.tgz > SHA256SUMS)
          cat artifacts/SHA256SUMS
      - name: Retain exact helm artifacts before publication
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: release-helm-${{ inputs.revision }}-${{ github.run_attempt }}
          path: artifacts/
          if-no-files-found: error
          retention-days: 14
      - name: Build and publish immutable OCI image and chart
        env:
          GHCR_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GHCR_USER: ${{ github.actor }}
        run: |
          image="ghcr.io/${GITHUB_REPOSITORY,,}"
          printf '%s' "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin
          printf '%s' "$GHCR_TOKEN" | helm registry login ghcr.io -u "$GHCR_USER" --password-stdin
          # Fail closed unless registry explicitly confirms absence; network/auth errors block.
          for reference in "$image:$RELEASE_VERSION" "$image/charts/demo:$RELEASE_VERSION"; do
            if docker manifest inspect "$reference" > /tmp/manifest.out 2>/tmp/manifest.err; then
              echo 'Version exists; reconcile its digest before recovery.' >&2; exit 1
            fi
            grep -Eqi 'manifest unknown|no such manifest' /tmp/manifest.err
          done
          docker build --label "org.opencontainers.image.version=$RELEASE_VERSION" --label "org.opencontainers.image.revision=$RELEASE_SHA" -t "$image:$RELEASE_VERSION" .
          docker push "$image:$RELEASE_VERSION"
          docker inspect --format '{{join .RepoDigests "\n"}}' "$image:$RELEASE_VERSION"
          helm push "artifacts/demo-$RELEASE_VERSION.tgz" "oci://$image/charts"
