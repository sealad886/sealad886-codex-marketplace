# Inactive example. Read references/ci/github-actions.md before materializing.
name: Publish maven
on:
  workflow_call:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
  workflow_dispatch:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: publish-maven-main
  cancel-in-progress: false
jobs:
  publish:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    environment: release
    permissions:
      contents: read
      packages: write
    env:
      RELEASE_SHA: ${{ inputs.revision }}
      RELEASE_TAG: ${{ inputs.tag }}
      RELEASE_VERSION: ${{ inputs.version }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.revision }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable release source
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
          git check-ref-format "refs/tags/$RELEASE_TAG"
          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
          test "$(git rev-parse --verify "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
          git merge-base --is-ancestor "$RELEASE_SHA" refs/remotes/origin/main
          test -n "$RELEASE_VERSION"
          test "$RELEASE_TAG" = "v$RELEASE_VERSION"
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3
        with:
          distribution: temurin
          java-version: '21.0.6+7'
          server-id: github
          server-username: GITHUB_ACTOR
          server-password: GITHUB_TOKEN
      - name: Check effective project version
        run: |
          test "$(./mvnw -q help:evaluate -Dexpression=project.version -DforceStdout)" = "$RELEASE_VERSION"
          ./mvnw --batch-mode verify
      - name: Deploy to configured GitHub Maven repository
        run: ./mvnw --batch-mode deploy -DskipTests
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
