# Inactive example. Read references/ci/github-actions.md before materializing.
name: Publish go
on:
  workflow_call:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
  workflow_dispatch:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: publish-go-main
  cancel-in-progress: false
jobs:
  publish:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    environment: release
    permissions:
      contents: write
    env:
      RELEASE_SHA: ${{ inputs.revision }}
      RELEASE_TAG: ${{ inputs.tag }}
      RELEASE_VERSION: ${{ inputs.version }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.revision }}
          fetch-depth: 0
          persist-credentials: false
      - name: Prepare verified draft and release tag
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          [[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
          git check-ref-format "refs/tags/$RELEASE_TAG"
          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
          git merge-base --is-ancestor "$RELEASE_SHA" refs/remotes/origin/main
          test "$RELEASE_TAG" = "v$RELEASE_VERSION"
          gh release view "$RELEASE_TAG" --json isDraft,targetCommitish,assets > "$RUNNER_TEMP/go-release.json"
          python - <<'PY'
          import json, os
          from pathlib import Path
          release = json.loads((Path(os.environ['RUNNER_TEMP']) / 'go-release.json').read_text())
          assert release['isDraft'], 'Go assets require an unpublished draft release'
          assert release['targetCommitish'] == os.environ['RELEASE_SHA'], 'Draft must target the approved exact SHA'
          assert not release['assets'], 'Existing assets require reviewed partial-release recovery'
          PY
          # GitHub can defer tag creation until draft publication. Create only
          # the missing ref; API conflicts fail closed and never force-update it.
          if ! git show-ref --verify --quiet "refs/tags/$RELEASE_TAG"; then
            created=$(gh api --method POST "repos/$GITHUB_REPOSITORY/git/refs" -f "ref=refs/tags/$RELEASE_TAG" -f "sha=$RELEASE_SHA" --jq '.object.sha')
            test "$created" = "$RELEASE_SHA"
            git update-ref "refs/tags/$RELEASE_TAG" "$RELEASE_SHA"
          fi
      - name: Verify immutable release source
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
          git check-ref-format "refs/tags/$RELEASE_TAG"
          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
          test "$(git rev-parse --verify "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
          git merge-base --is-ancestor "$RELEASE_SHA" refs/remotes/origin/main
          test -n "$RELEASE_VERSION"
          test "$RELEASE_TAG" = "v$RELEASE_VERSION"
      - uses: actions/setup-go@40f1582b2485089dde7abd97c1529aa768e1baff
        with:
          go-version-file: go.mod
          check-latest: false
      - run: go test ./...
      - name: Check module version and tag
        run: |
          test "$RELEASE_TAG" = "v$RELEASE_VERSION"
          go list -m
          test "$(git rev-parse --verify "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
      - uses: goreleaser/goreleaser-action@e435ccd777264be153ace6237001ef4d979d3a7a
        with:
          distribution: goreleaser
          version: v2.8.2
          args: release --clean --draft
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GORELEASER_CURRENT_TAG: ${{ inputs.tag }}
      - name: Verify uploaded assets and finalize draft
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          gh release view "$RELEASE_TAG" --json isDraft,assets > "$RUNNER_TEMP/go-assets.json"
          python - <<'PY'
          import json, os
          from pathlib import Path
          release = json.loads((Path(os.environ['RUNNER_TEMP']) / 'go-assets.json').read_text())
          assert release['isDraft'], 'Release must remain draft until assets pass checks'
          assert release['assets'], 'No release assets were uploaded'
          actual = {asset['name'] for asset in release['assets']}
          assert 'checksums.txt' in actual and len(actual) > 1, actual
          PY
          gh release download "$RELEASE_TAG" --dir "$RUNNER_TEMP/go-download"
          cmp dist/checksums.txt "$RUNNER_TEMP/go-download/checksums.txt"
          (cd "$RUNNER_TEMP/go-download" && sha256sum --check checksums.txt)
          gh release edit "$RELEASE_TAG" --draft=false
