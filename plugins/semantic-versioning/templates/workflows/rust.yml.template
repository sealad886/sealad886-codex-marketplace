# Inactive example. Read references/ci/github-actions.md before materializing.
name: Publish rust
on:
  workflow_call:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
    secrets:
      CARGO_REGISTRY_TOKEN:
        required: true
  workflow_dispatch:
    inputs:
      revision:
        description: Approved full 40-character release commit SHA
        type: string
        required: true
      tag:
        description: Existing immutable release tag
        type: string
        required: true
      version:
        description: Expected native package version
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: publish-rust-main
  cancel-in-progress: false
jobs:
  publish:
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    environment: release
    permissions:
      contents: read
    env:
      RELEASE_SHA: ${{ inputs.revision }}
      RELEASE_TAG: ${{ inputs.tag }}
      RELEASE_VERSION: ${{ inputs.version }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.revision }}
          fetch-depth: 0
          persist-credentials: false
      - name: Verify immutable release source
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]
          git check-ref-format "refs/tags/$RELEASE_TAG"
          test "$(git rev-parse HEAD)" = "$RELEASE_SHA"
          test "$(git rev-parse --verify "refs/tags/$RELEASE_TAG^{commit}")" = "$RELEASE_SHA"
          git merge-base --is-ancestor "$RELEASE_SHA" refs/remotes/origin/main
          test -n "$RELEASE_VERSION"
          test "$RELEASE_TAG" = "v$RELEASE_VERSION"
      - name: Select pinned project Rust toolchain
        run: |
          test -f rust-toolchain.toml
          rustup show active-toolchain
          cargo metadata --locked --no-deps --format-version 1 > "$RUNNER_TEMP/cargo-metadata.json"
      - name: Check fixed workspace versions and explicit publish order
        shell: python
        run: |
          import json, os
          from pathlib import Path
          data = json.load(open(Path(os.environ['RUNNER_TEMP']) / 'cargo-metadata.json'))
          members = {p['name']: p for p in data['packages'] if p['id'] in data['workspace_members'] and p.get('publish') != []}
          order = [s.strip() for s in open('release-order.txt') if s.strip()]
          assert len(order) == len(set(order)) and set(order) == set(members)
          seen = set()
          for name in order:
              package = members[name]
              assert package['version'] == os.environ['RELEASE_VERSION']
              required = {d['name'] for d in package['dependencies'] if d.get('path') and d['kind'] != 'dev'} & members.keys()
              assert required <= seen, (name, required - seen)
              seen.add(name)
          (Path(os.environ['RUNNER_TEMP']) / 'release-order.txt').write_text('\n'.join(order) + '\n')
      - run: cargo test --workspace --locked
      - name: Publish in dependency order
        env:
          CARGO_REGISTRY_TOKEN: ${{ secrets.CARGO_REGISTRY_TOKEN }}
        run: |
          while IFS= read -r package || test -n "$package"; do
            test -z "$package" && continue
            cargo publish --locked --package "$package"
          done < "$RUNNER_TEMP/release-order.txt"
